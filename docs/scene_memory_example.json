      "play_media_gym_gym": {
        "id": "play_media_gym_gym",
        "intent": "play_media_gym",
        "area_hint": "gym",
        "summary": "4 steps: service_call, delay, service_call, +1 more",
        "steps": [
          {
            "type": "service_call",
            "service": "media_player.turn_on",
            "data": {
              "entity_id": "media_player.gym_atv"
            },
            "only_if_state": {
              "entity_id": "media_player.gym_atv",
              "not_in": [
                "idle",
                "playing"
              ]
            }
          },
          {
            "type": "delay",
            "seconds": 1,
            "only_if_state": {
              "entity_id": "media_player.gym_atv",
              "not_in": [
                "idle",
                "playing"
              ]
            }
          },
          {
            "type": "service_call",
            "service": "media_player.select_source",
            "data": {
              "entity_id": "media_player.gym_atv",
              "source": "Plex"
            }
          },
          {
            "type": "delay",
            "seconds": 1
          }
        ],
        "strategy": "Plays Moana (2016) by default in gym.",
