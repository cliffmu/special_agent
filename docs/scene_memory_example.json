    "play_media_gym_gym": {
      "id": "play_media_gym_gym",
      "intent": "play_media_gym",
      "area_hint": "gym",
      "summary": "5 steps: service_call, delay, service_call, +2 more",
      "steps": [
        {
          "type": "service_call",
          "service": "media_player.turn_on",
          "data": {
            "entity_id": "media_player.gym_atv"
          },
          "only_if_state": {
            "entity_id": "media_player.gym_atv",
            "not_in": [
              "idle",
              "playing"
            ]
          }
        },
        {
          "type": "delay",
          "seconds": 6,
          "only_if_state": {
            "entity_id": "media_player.gym_atv",
            "not_in": [
              "idle",
              "playing"
            ]
          }
        },
        {
          "type": "service_call",
          "service": "media_player.select_source",
          "data": {
            "entity_id": "media_player.gym_atv",
            "source": "Plex"
          },
          "only_if_state": {
            "entity_id": "media_player.gym_atv",
            "attribute": "app_name",
            "not_equals": "Plex"
          }
        },
        {
          "type": "delay",
          "seconds": 3
        },
        {
          "type": "tool_call",
          "tool": "play_plex_media",
          "args": {
            "rating_key": "${rating_key}",
            "plex_client_entity": "${plex_client_entity}",
            "parent_device_entity": "media_player.gym_atv"
          }
        }
      ],
      "strategy": "Added play_plex_media tool_call with variables for rating_key and plex_client_entity; adjusted delays for device startup; preserved guards.",
      "confidence": 0.8,
      "updated_at": 1760996365.9434192,
      "client_config": {}
    },
    "play_media_main_bedroom_main_bedroom": {
      "id": "play_media_main_bedroom_main_bedroom",
      "intent": "play_media_main_bedroom",
      "area_hint": "main_bedroom",
      "summary": "6 steps with guards: handles all remote/TV sync states",
      "steps": [
        {
          "type": "service_call",
          "service": "remote.turn_on",
          "data": {
            "entity_id": "remote.bedroom_remote",
            "activity": "Watch Apple TV"
          }
        },
        {
          "type": "delay",
          "seconds": 9,
          "only_if_state": {
            "entity_id": "media_player.main_bedroom_apple_tv",
            "in": [
              "off",
              "unavailable",
              "standby"
            ]
          }
        },
        {
          "type": "service_call",
          "service": "media_player.turn_on",
          "data": {
            "entity_id": "media_player.main_bedroom_apple_tv"
          },
          "only_if_state": {
            "entity_id": "media_player.main_bedroom_apple_tv",
            "in": [
              "off",
              "unavailable",
              "standby"
            ]
          }
        },
        {
          "type": "delay",
          "seconds": 2,
          "only_if_state": {
            "entity_id": "media_player.main_bedroom_apple_tv",
            "in": [
              "off",
              "unavailable",
              "standby"
            ]
          }
        },
        {
          "type": "service_call",
          "service": "media_player.select_source",
          "data": {
            "entity_id": "media_player.main_bedroom_apple_tv",
            "source": "Plex"
          },
          "only_if_state": {
            "entity_id": "media_player.main_bedroom_apple_tv",
            "attribute": "app_name",
            "not_equals": "Plex"
          }
        },
        {
          "type": "delay",
          "seconds": 3,
          "only_if_state": {
            "entity_id": "media_player.main_bedroom_apple_tv",
            "attribute": "app_name",
            "not_equals": "Plex"
          }
        }
      ],
      "strategy": "Handles all sync states: always ensures Harmony activity (idempotent), skips TV boot if already on, skips Plex if already open. Fast path: ~100ms.",
      "confidence": 0.8,
      "updated_at": 1760589038.7836964,
      "client_config": {
        "plex_client_entity": "media_player.plex_plex_for_apple_tv_apple_tv_main_bedroom",
        "client_ip": "192.168.86.206",
        "parent_device_entity": "media_player.main_bedroom_apple_tv"
      }
    },
    "Plex on SHIELD \u2014 Theater_theater": {
      "id": "Plex on SHIELD \u2014 Theater_theater",
      "intent": "Plex on SHIELD \u2014 Theater",
      "area_hint": "theater",
      "summary": "6 steps: service_call, delay, service_call, +3 more",
      "steps": [
        {
          "type": "service_call",
          "service": "remote.turn_on",
          "data": {
            "entity_id": "remote.theater_remote",
            "activity": "SHIELD TV"
          }
        },
        {
          "type": "delay",
          "seconds": 30
        },
        {
          "type": "service_call",
          "service": "media_player.turn_on",
          "data": {
            "entity_id": "media_player.android_tv_192_168_86_34"
          }
        },
        {
          "type": "service_call",
          "service": "media_player.play_media",
          "data": {
            "entity_id": "media_player.shield_2",
            "media_content_type": "app",
            "media_content_id": "com.plexapp.android"
          }
        },
        {
          "type": "service_call",
          "service": "media_player.play_media",
          "data": {
            "entity_id": "media_player.plex_plex_for_android_tv_shield_android_tv",
            "media_content_type": "library",
            "media_content_id": "${plex_rating_key}"
          }
        },
        {
          "type": "service_call",
          "service": "media_player.turn_on",
          "data": {
            "entity_id": "media_player.theater_amp"
          }
        }
      ],
      "strategy": "Removed hard-coded movie ID and replaced with ${plex_rating_key} placeholder so scene can be used for any Plex content. Saved Plex SHIELD client and Companion IP for reliability.",
      "confidence": 0.8,
      "updated_at": 1760912205.6097405,
      "client_config": {
        "plex_client_entity": "media_player.plex_plex_for_android_tv_shield_android_tv",
        "client_ip": "192.168.86.205"
      }
    },
